<!DOCTYPE html>
<html lang="en">
  <head>
    {% include "head.njk" %}
  </head>
  <body class="docs">
    <header class="topbar">
      <a class="brand" href="{{ '/' | url }}">{{ site.title }}</a>
      <nav class="top-links" aria-label="Top">
        <a href="{{ '/' | url }}">Overview</a>
        <a href="{{ '/syllabus/' | url }}">Syllabus</a>
        <a href="{{ '/setup/' | url }}">Setup</a>
        <a href="{{ site.repo }}" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </header>

    <div class="docs-shell">
      <aside class="sidebar" aria-label="Course navigation">
        {% include "sidebar.njk" %}
      </aside>

      <div class="docs-main">
        {% if title %}
        <header class="page-header">
          <h1>{{ title }}</h1>
          {% if subtitle %}
          <p class="subtitle">{{ subtitle }}</p>
          {% endif %}
          {% if slides or notebook %}
          <p class="page-actions">
            {% if slides %}
            <a class="btn" href="{{ slides | url }}" target="_blank" rel="noopener">Open slides</a>
            {% endif %}
            {% if notebook %}
            <a class="btn btn-secondary" href="{{ notebook }}" target="_blank" rel="noopener">Notebook</a>
            {% endif %}
          </p>
          {% endif %}
        </header>
        {% endif %}

        <article class="prose" id="content">
          {{ content | safe }}
        </article>

        <footer class="page-footer">
          <p>
            {{ site.longTitle }} ·
            <a href="{{ site.instructorUrl }}" target="_blank" rel="noopener">{{ site.instructor }}</a>
          </p>
        </footer>
      </div>

      <aside class="toc" aria-label="On this page">
        {% set headings = content | tocHeadings %}
        {% if headings.length %}
        <p class="toc-title">On this page</p>
        <ul>
          {% for h in headings %}
          <li class="toc-l{{ h.level }}">
            <a href="#{{ h.id }}">{{ h.text }}</a>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </aside>
    </div>

    <script src="{{ '/js/toc.js' | url }}"></script>
  </body>
</html>
