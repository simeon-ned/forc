---
pagination:
  data: lectureRedirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}"
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ redirect.title }} — moved</title>
<meta http-equiv="refresh" content="0; url={{ redirect.to | url }}">
<link rel="canonical" href="{{ course.site_url }}{{ redirect.to }}">
</head><body><p>This lecture has moved to <a href="{{ redirect.to | url }}">{{ redirect.title }}</a>.</p></body></html>
